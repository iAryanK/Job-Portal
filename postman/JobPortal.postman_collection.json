	"item": [
		{
			"name": "Auth",
			"description": "Public authentication endpoints. No bearer token required.",
			"item": [
				{
					"name": "Send Email OTP",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/core/send-email-otp",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "core", "send-email-otp"]
						},
						"description": "Sends an OTP to the given email. Returns 204 No Content."
					},
					"response": []
				},
				{
					"name": "Authenticate Via Email",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 201) {",
									"    const json = pm.response.json();",
									"    const data = json.data || json;",
									"    if (data.accessToken) {",
									"        pm.collectionVariables.set('accessToken', data.accessToken);",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\",\n  \"role\": \"{{role}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/core/email",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "core", "email"]
						},
						"description": "Authenticates with email OTP.\n\n`role` values: `ADMIN` | `JOBSEEKER` | `EMPLOYER` | `USER`\n\nSets `refreshToken` cookie and saves `accessToken` to collection variables."
					},
					"response": []
				},
				{
					"name": "Authenticate Via Google",
